<?xml version="1.0" encoding="utf-8"?>
<!--
  Fire TV / Fire OS Leanback manifest.

  The three declarations Amazon's Fire TV app checks look for are all here:
    - android.software.leanback required, which marks the app as a TV app;
    - android.hardware.touchscreen not required, so it installs on a device
      that has only a remote;
    - a LEANBACK_LAUNCHER category, so it appears on the Fire TV home row.

  There is deliberately no `package` attribute: Android Gradle Plugin 8 takes the
  application id from `namespace` in app/build.gradle.kts and fails the build when
  the manifest declares one as well.

  This is the only manifest a release build merges, so `usesCleartextTraffic` is
  declared `false` here rather than left to the platform default. The debug source
  set at app/src/debug/AndroidManifest.xml turns it back on for local development,
  where the cockpit is served over plain http from a laptop on the same network.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- A Fire TV stick has no GPS, camera or telephony; say so explicitly so the
         Appstore does not filter the app off devices that lack them. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/firetv_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:logo="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Leanback"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
